{
  "name": "sonotas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "build-font": "pnpm --filter ./apps/web build-font",
    "aequitas:sync": "cp ../aequitas/dist/aequitas.css ../aequitas/dist/aequitas.icons.css app/assets/aequitas/ && cp ../aequitas/dist/fonts/*.woff2 app/assets/aequitas/fonts/"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "renderer": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.5.1"
}
