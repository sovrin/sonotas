# Keep the build context small and never overwrite the image's Linux-native
# node_modules with the host's (COPY . . would otherwise clobber the install).
node_modules
**/node_modules
.nuxt
.output
.git
.github
.idea
.context
.playwright-mcp
*.log
.DS_Store
.env
.env.*
Dockerfile
.dockerignore
docker-compose.yml
# regenerated inside the image by the font-build stage
public/fonts
